# SWENA Travel Intelligence Frontend Environment

# SWYRA Auth (OAuth 2.1 / OIDC Identity Provider)
# Refer to https://github.com/SGOD-pro/OAuth2.1
AUTH_ISSUER=https://oauth21.vercel.app
JWKS_URL=https://oauth21.vercel.app/.well-known/jwks.json
CLIENT_ID=your_swyra_client_id
CLIENT_SECRET=your_swyra_client_secret
REDIRECT_URI=http://localhost:3000/api/auth/callback

# FastAPI Backend URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
