# SWENA Travel Intelligence Frontend Environment

# Better Auth (local PostgreSQL)
BETTER_AUTH_SECRET=replace_with_a_random_32_byte_secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travel_planning
# Development only: allow the Next.js proxy to reach the local FastAPI backend.
LOCAL_AUTH_BYPASS=true

# FastAPI Backend URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Map Tiles (CARTO)
NEXT_PUBLIC_CARTO_API_KEY=your_carto_public_api_key