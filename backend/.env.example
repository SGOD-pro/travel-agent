# ==============================================================================
# SWENA Backend Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# PHASE 1 REQUIREMENTS: Core Runtime & PostgreSQL Persistence
# Required for: Orchestrator execution repositories, leases, lifecycle, outbox
# ------------------------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true
# Local-only auth bypass for testing protected API flows without SWYRA.
# Keep false for all shared, staging, and production environments.
LOCAL_AUTH_BYPASS=false

# Database (PostgreSQL 16 + PostGIS)
# Default points to local docker-compose instance
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/travel_planning

# ------------------------------------------------------------------------------
# DOWNSTREAM PHASES & OPTIONAL SERVICES
# ------------------------------------------------------------------------------

# Redis Cache (Optional for Phase 1; required for shared rate limiting and cache)
REDIS_BACKEND=local
REDIS_URL=redis://localhost:6379/0
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# SWYRA Auth (OAuth 2.1 / OIDC Resource Server JWT validation)
AUTH_ISSUER=https://oauth21.vercel.app
JWKS_URL=https://oauth21.vercel.app/.well-known/jwks.json
CLIENT_ID=swena_travel_agent_client

# External Providers (Phase 4+ Evidence, Phase 6+ Models, Phase 7+ Routing)
AWS_REGION=ap-south-1
SQS_QUEUE_URL=
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
SERPAPI_API_KEY=
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Google Directions API endpoint used for route geometry.
GOOGLE_MAPS_MATRIX_URL=https://routes.googleapis.com/distanceMatrix/v2:computeRouteMatrix
GOOGLE_MAPS_DIRECTIONS_URL=https://routes.googleapis.com/directions/v2:computeRoutes

# Direct media file downloads only. YouTube watch URLs use public captions.
# Use exact hostnames; do not use wildcards.
# Example: MEDIA_ALLOWED_HOSTS=["cdn.example.com","images.example.com"]
MEDIA_ALLOWED_HOSTS=[]
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=20
MEDIA_ANALYSIS_PROVIDER=mock
MEDIA_GEOCODER_PROVIDER=none
MEDIA_TRANSCRIBE_TIMEOUT_SECONDS=300
MEDIA_TRANSCRIBE_POLL_INTERVAL_SECONDS=2

# Required when MEDIA_ANALYSIS_PROVIDER=aws. Use an AWS IAM role/profile;
# do not put AWS credentials in this file.
AWS_MEDIA_BUCKET=

# Public Nominatim usage requires a descriptive app name and contact address.
# Set provider=nominatim only after supplying your real contact details.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=
