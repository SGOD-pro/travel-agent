# Travel Planning Platform Backend Environment

ENVIRONMENT=local
DEBUG=true

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/travel_planning

# Redis Configuration (local Docker or upstash)
REDIS_BACKEND=local
REDIS_URL=redis://localhost:6379/0
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# SWYRA Auth (OAuth 2.1 / OIDC Resource Server Validation)
# Refer to https://github.com/SGOD-pro/OAuth2.1
AUTH_ISSUER=https://oauth21.vercel.app
JWKS_URL=https://oauth21.vercel.app/.well-known/jwks.json
CLIENT_ID=your_swyra_client_id
